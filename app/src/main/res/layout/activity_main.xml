<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/matcha_cream"
    tools:context=".MainActivity">

    <!-- Motif daun -->
    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_pattern_leaves"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Semak bawah -->
    <ImageView
        android:id="@+id/ivBush"
        android:layout_width="0dp"
        android:layout_height="130dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_bush"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toTopOf="@id/ivBush"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4">

        <!-- Logo -->
        <ImageView
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:background="@drawable/bg_logo_circle"
            android:contentDescription="Logo Chitato Lite"
            android:elevation="8dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/chittato_logo" />

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/chewy"
            android:gravity="center"
            android:lineSpacingMultiplier="1.05"
            android:text="Keripik Kentang Renyah,\nRasa Meledak di Mulut!"
            android:textColor="@color/matcha_green"
            android:textSize="24sp" />

        <!-- Tombol utama -->
        <Button
            android:id="@+id/btnMyProject"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_button_matcha"
            android:backgroundTint="@null"
            android:elevation="4dp"
            android:fontFamily="@font/chewy"
            android:text="Lihat Detail Snack"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:backgroundTint="@null" />

        <!-- Profil developer -->
        <Button
            android:id="@+id/btnProfile"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_button_outline_matcha"
            android:backgroundTint="@null"
            android:fontFamily="@font/chewy"
            android:text="@string/btn_profile"
            android:textAllCaps="false"
            android:textColor="@color/matcha_green"
            android:textSize="16sp"
            app:backgroundTint="@null" />

        <!-- Logout -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@android:color/transparent"
            android:backgroundTint="@null"
            android:text="@string/btn_logout"
            android:textAllCaps="false"
            android:textColor="@color/matcha_error"
            android:textSize="14sp"
            app:backgroundTint="@null" />

        <!-- Footer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Chitato — Cemilan Favorit Sejak Dulu"
            android:textColor="@color/matcha_green_dark"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>